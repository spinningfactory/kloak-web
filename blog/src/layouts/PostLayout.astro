---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author, tags } = Astro.props;
---

<BaseLayout title={`${title} — Kloak Blog`} description={description} article publishedTime={pubDate}>
  <article class="post">
    <header class="post-header container container-narrow">
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag.toLowerCase()}/`} class="post-tag">{tag}</a>
          ))}
        </div>
      )}
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <span>{author}</span>
        <span class="post-meta-divider">·</span>
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <>
            <span class="post-meta-divider">·</span>
            <span>Updated <FormattedDate date={updatedDate} /></span>
          </>
        )}
      </div>
    </header>
    <div class="post-body container container-narrow">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 4rem 0 6rem;
  }

  .post-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .post-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--color-primary-light);
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(23, 130, 206, 0.25);
    border-radius: 9999px;
    background: rgba(23, 130, 206, 0.08);
    transition: background 150ms ease, border-color 150ms ease;
  }

  .post-tag:hover {
    background: rgba(23, 130, 206, 0.15);
    border-color: rgba(23, 130, 206, 0.45);
    color: var(--color-primary-light);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    max-width: 640px;
    margin: 0 auto 1.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .post-meta-divider {
    color: var(--color-text-muted);
  }

  .post-body {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .post-body :global(h2) {
    font-size: 1.875rem;
    font-weight: 700;
    margin: 3rem 0 1rem;
    letter-spacing: -0.01em;
  }

  .post-body :global(h3) {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
  }

  .post-body :global(p) {
    margin-bottom: 1.25rem;
    color: rgba(243, 244, 246, 0.85);
  }

  .post-body :global(a) {
    text-decoration: underline;
    text-decoration-color: rgba(72, 162, 232, 0.4);
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    text-decoration-color: var(--color-primary-light);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.5rem;
    color: rgba(243, 244, 246, 0.85);
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding: 0.5rem 0 0.5rem 1.5rem;
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  .post-body :global(img) {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .post-body :global(th),
  .post-body :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .post-body :global(th) {
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-bg-secondary);
  }
</style>
