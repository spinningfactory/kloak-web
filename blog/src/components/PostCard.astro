---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, author, tags } = post.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/${post.id}/`;
---

<article class:list={['post-card', featured && 'post-card-featured']}>
  <a href={href} class="post-card-link">
    {tags.length > 0 && (
      <div class="post-card-tags">
        <span class="post-card-tag">{tags[0]}</span>
      </div>
    )}
    <h2 class="post-card-title">{title}</h2>
    <p class="post-card-description">{description}</p>
    <div class="post-card-meta">
      <span>{author}</span>
      <span class="post-card-divider">·</span>
      <FormattedDate date={pubDate} />
    </div>
  </a>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, rgba(30, 41, 59, 0.4) 0%, rgba(17, 24, 39, 0.4) 100%);
    overflow: hidden;
    transition: border-color 200ms ease, transform 200ms ease, background 200ms ease;
  }

  .post-card:hover {
    border-color: rgba(23, 130, 206, 0.4);
    transform: translateY(-2px);
  }

  .post-card-link {
    display: block;
    padding: 2rem;
    color: var(--color-text);
    height: 100%;
  }

  .post-card-link:hover {
    color: var(--color-text);
  }

  .post-card-featured {
    border-color: rgba(23, 130, 206, 0.3);
    background: linear-gradient(180deg, rgba(23, 130, 206, 0.08) 0%, rgba(17, 24, 39, 0.4) 100%);
  }

  .post-card-featured .post-card-link {
    padding: 2.5rem;
  }

  .post-card-featured .post-card-title {
    font-size: 1.875rem;
  }

  .post-card-tags {
    margin-bottom: 1rem;
  }

  .post-card-tag {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--color-primary-light);
    padding: 0.2rem 0.65rem;
    border: 1px solid rgba(23, 130, 206, 0.25);
    border-radius: 9999px;
    background: rgba(23, 130, 206, 0.08);
  }

  .post-card-title {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  .post-card-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .post-card-divider {
    opacity: 0.5;
  }
</style>
