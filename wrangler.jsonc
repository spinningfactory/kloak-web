{
  // Cloudflare Workers (Static Assets) config for kloak-web.
  // The site is deployed via the Workers + Static Assets path (unified Workers & Pages UI).
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "kloak-web",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./_site"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
